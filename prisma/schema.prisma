generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  COACH
  ATHLETE
  ADMIN
}

enum CoachAthleteLinkStatus {
  PENDING
  ACCEPTED
  REJECTED
  REMOVED
}

enum WorkoutType {
  RUN
  BIKE
  SWIM
  STRENGTH
  HYROX
  TRIATHLON
  RECOVERY
  REST
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum AthleteLogType {
  COMPLETED
  SKIPPED
  ADJUSTED
  RESCHEDULED
}

enum SessionType {
  EASY_RUN
  RECOVERY_RUN
  LONG_RUN
  TEMPO
  THRESHOLD
  VO2_MAX
  INTERVALS
  FARTLEK
  RACE_PACE
  HILL_REPEATS
  BRICK
  STRENGTH
  CROSS_TRAINING
  HYROX
  CUSTOM
}

enum RaceType {
  MARATHON
  HALF_MARATHON
  FIVE_K
  TEN_K
  HYROX
  TRIATHLON
  CYCLING
  OTHER
}

/** Surface / course style — depends on sport (Road, Trail, Gravel, …). */
enum RaceCourseType {
  ROAD
  TRAIL
  TRACK
  GRAVEL
  MTB
  POOL
  OPEN_WATER
  OTHER
}

/** Triathlon distance variant when Race.type = TRIATHLON. */
enum TriathlonDistance {
  SPRINT
  OLYMPIC
  HALF
  FULL
  CUSTOM
}

enum RacePriority {
  A
  B
  C
}

enum RaceIntent {
  PLANNED
  WATCHING
}

enum RaceOutcome {
  FINISHED
  DID_NOT_START
  DNF
  DISMISSED
}

/** Triathlon (and similar) race segments — sport legs can link Strava; T1/T2 are time-only. */
enum RaceLegKind {
  SWIM
  T1
  BIKE
  T2
  RUN
}

enum SeasonPhase {
  BASE
  BUILD
  PEAK
  RACE
  RECOVERY
  TRANSITION
  MAINTENANCE
}

enum DayNoteStatus {
  NEEDS_COACH
  AVAILABLE
  SELF_PLANNED
  BUSY
}

enum CoachingThreadKind {
  GENERAL
  ASK
  FEEDBACK
  RACE_REPORT
}

enum CoachingThreadStatus {
  OPEN
  RESOLVED
}

enum CoachingAuthorRole {
  ATHLETE
  COACH
}

enum CoachingMessageKind {
  CHAT
  FEEDBACK
}

enum AthleteStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SwimEnvironment {
  POOL
  OPEN_WATER
}

/**
 * Provenance for a planned distance/duration value.
 * MANUAL — user entered (or locked); keep absolute when applying templates.
 * STRUCTURE — derived from workout blocks; recompute per athlete prefs.
 * COMPANION — derived from the other metric via pace/speed/CSS; recompute per athlete.
 */
enum PlannedMetricSource {
  MANUAL
  STRUCTURE
  COMPANION
}

enum CalendarFeedType {
  TRAINING
  RACES
}

enum PersonalBestSport {
  RUN
  BIKE
  SWIM
  TRIATHLON
  HYROX
  GYM
  OTHER
}

enum PersonalBestMetric {
  TIME
  WEIGHT_KG
  REPS
  WATTS
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /** bcrypt hash — null when OAuth-only */
  passwordHash  String?
  /** Multi-role: ATHLETE, COACH, ADMIN (admin never self-assigned). */
  roles         UserRole[] @default([])
  /** Coach: warn on dashboard when an active athlete has no plan this many days ahead. */
  planningLeadDays Int @default(3)
  /** Coach: workout builder add-block presets (order, labels, seeds) per sport. */
  workoutBuilderPrefs Json?
  /** Skip onboarding until user picks Start Training / Become a Coach. */
  onboardingSkippedAt DateTime?
  /** Soft block — user cannot sign in while set. */
  disabledAt DateTime?
  disabledReason String?
  /**
   * Optional Web Push category prefs (all default on when null).
   * Shape: { messages?, workoutAsks?, workoutFeedback?, raceThreads?, mentions? }
   */
  notificationPrefs Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  athleteProfile    Athlete?
  coachProfile      CoachProfile?
  templates         WorkoutTemplate[]
  templateFolders   WorkoutTemplateFolder[]
  stravaConnection  StravaConnection?
  webPushSubscriptions WebPushSubscription[]
  coachAttentionDismissals CoachAttentionDismissal[]
}

/** Coach dismissed a Needs attention item on Home (snooze until state changes). */
model CoachAttentionDismissal {
  id          String   @id @default(cuid())
  coachUserId String
  itemKey     String
  /** Snapshot when dismissed — used to re-show messages/planning when state changes. */
  contextAt   String   @default("")
  dismissedAt DateTime @default(now())

  coach User @relation(fields: [coachUserId], references: [id], onDelete: Cascade)

  @@unique([coachUserId, itemKey])
  @@index([coachUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CoachProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  /** Public invite code, e.g. TT-83KF9 */
  coachingCode String   @unique
  bio          String?
  /** Coach-facing photo (independent of athlete avatar / OAuth User.image). */
  avatarUrl    String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  links CoachAthleteLink[]
}

model CoachAthleteLink {
  id             String                  @id @default(cuid())
  coachProfileId String
  athleteId      String
  status         CoachAthleteLinkStatus  @default(PENDING)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  athlete      Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachProfileId, athleteId])
  @@index([athleteId, status])
  @@index([coachProfileId, status])
}

model StravaConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  stravaAthleteId String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  scope           String
  lastSyncedAt    DateTime?
  /** When true, app load / login may auto-sync (debounced). Manual sync always available. */
  autoSyncEnabled Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Athlete {
  id        String        @id @default(cuid())
  /** Legacy primary coach user id — prefer CoachAthleteLink for access. */
  coachId   String?
  userId    String?       @unique
  name      String
  status    AthleteStatus @default(ACTIVE)
  avatarUrl String?
  /** Personal invite token for coach-managed athletes to link a User account. */
  claimToken String? @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Training pace zones (min/km, e.g. 5.5 = 5:30/km)
  paceRecoveryMinPerKm    Float?
  paceEasyMinPerKm        Float?
  paceTempoMinPerKm       Float?
  paceThresholdMinPerKm   Float?
  paceVo2MaxMinPerKm      Float?

  // Bike speed zones (km/h)
  bikeSpeedRecoveryKph    Float?
  bikeSpeedEasyKph        Float?
  bikeSpeedTempoKph       Float?
  bikeSpeedThresholdKph   Float?
  bikeSpeedVo2MaxKph      Float?
  /** Functional Threshold Power (watts) for %FTP targets. */
  bikeFtpWatts            Int?

  // Critical swim speed (seconds per 100m, e.g. 95 = 1:35/100)
  swimCssSecPer100m       Float?

  // Heart rate zones (bpm)
  hrMax       Int?
  hrResting   Int?
  hrZone1Max  Int?
  hrZone2Max  Int?
  hrZone3Max  Int?
  hrZone4Max  Int?

  // Weather defaults used across week planning + dashboard
  weatherLocationName String?
  weatherLat          Float?
  weatherLon          Float?
  /** When true, forecast is shown above workouts by default. Week view can still toggle for the session. */
  showWeather         Boolean @default(true)

  // Coach training planner: default sport rows always shown
  planSportRows WorkoutType[] @default([RUN, BIKE, SWIM])

  user             User?                     @relation(fields: [userId], references: [id])
  coachLinks       CoachAthleteLink[]
  races            Race[]
  personalBests    PersonalBest[]
  seasonPhaseBlocks SeasonPhaseBlock[]
  seasonEvents      SeasonEvent[]
  calendarFeeds     CalendarFeed[]
  calendarEventMaps CalendarEventMap[]
  workouts         Workout[]
  dayNotes         DayNote[]
  coachingThreads  CoachingThread[]
  weekPlanSportRows        AthleteWeekPlanSportRow[]
  weekHiddenPlanSportRows AthleteWeekHiddenPlanSportRow[]

  @@index([coachId])
}

model AthleteWeekPlanSportRow {
  id        String      @id @default(cuid())
  athleteId String
  weekStart DateTime    @db.Date
  sport     WorkoutType
  createdAt DateTime    @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, weekStart, sport])
  @@index([athleteId, weekStart])
}

model AthleteWeekHiddenPlanSportRow {
  id        String      @id @default(cuid())
  athleteId String
  weekStart DateTime    @db.Date
  sport     WorkoutType
  createdAt DateTime    @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, weekStart, sport])
  @@index([athleteId, weekStart])
}

model Race {
  id        String       @id @default(cuid())
  athleteId String
  name      String
  date      DateTime     @db.Date
  location  String?
  type      RaceType
  sport     WorkoutType  @default(RUN)
  /** Road / Trail / Gravel / … — optional, sport-dependent. */
  courseType RaceCourseType?
  /** When type = TRIATHLON — Sprint, Olympic, 70.3, Ironman, Custom. */
  triathlonDistance TriathlonDistance?
  /** Freeform distance (km) when distance preset is Custom / Other. */
  customDistanceKm Float?
  priority  RacePriority @default(C)
  intent    RaceIntent   @default(PLANNED)
  goal      String?
  url       String?
  /** Athlete override; null uses default weeks for race type. */
  preparationWeeks Int?
  /** Set when athlete logs how the race went (or dismisses the prompt). */
  outcome      RaceOutcome?
  resultTime   String?
  /** Overall place / ranking (e.g. "12th", "3/240") — optional. */
  resultPlace  String?
  resultNotes  String?
  resultLoggedAt DateTime?
  /** Cleared when athlete logs a result; set when coach dismisses the dashboard alert. */
  resultDismissedAt DateTime?
  /** Single-sport race: linked Strava activity (triathlon uses RaceLeg instead). */
  stravaActivityId   String? @unique
  stravaActivityUrl  String?
  stravaActivityName String?
  /**
   * Results-log entry only — shown in Results, not on the season plan / training calendar.
   * Used for manually logged historical races.
   */
  resultsLogOnly Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  legs    RaceLeg[]
  personalBest PersonalBest?
  coachingThread CoachingThread?

  @@index([athleteId, date])
  @@index([athleteId, intent, date])
  @@index([athleteId, outcome, date])
}

/** Athlete-defined personal best (add/remove freely). */
model PersonalBest {
  id        String             @id @default(cuid())
  athleteId String
  /** Display name, e.g. "5K", "Olympic triathlon", "Deadlift". */
  name      String
  sport     PersonalBestSport
  /** Optional preset key for race auto-matching (FIVE_K, TRI_OLYMPIC, …). */
  presetKey String?
  metric    PersonalBestMetric @default(TIME)
  /** Minutes for TIME; kg / reps / watts for other metrics. */
  value     Float
  /**
   * Approximate or exact date: YYYY, YYYY-MM, or YYYY-MM-DD.
   * Year-only is fine when the exact day is unknown.
   */
  dateText  String?
  event     String?
  raceId    String?            @unique
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  race    Race?   @relation(fields: [raceId], references: [id], onDelete: SetNull)

  @@index([athleteId, sortOrder])
  @@index([athleteId, presetKey])
}

/** Per-leg plan + result for triathlon (swim / T1 / bike / T2 / run). */
model RaceLeg {
  id        String      @id @default(cuid())
  raceId    String
  kind      RaceLegKind
  sortOrder Int         @default(0)
  /** Target time for the plan (e.g. 1:05:00 or 3:30 for transitions). */
  plannedTime  String?
  plannedNotes String?
  /** Planned leg distance (km). Used for triathlon Custom splits. */
  plannedDistanceKm Float?
  /** Logged / Strava-derived split time. */
  resultTime String?
  stravaActivityId   String? @unique
  stravaActivityUrl  String?
  stravaActivityName String?
  actualDistanceKm   Float?
  actualDurationMin  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, kind])
  @@index([raceId])
}

/** Manual season planning phase block on a sport lane (not linked to workouts). */
model SeasonPhaseBlock {
  id        String       @id @default(cuid())
  athleteId String
  sport     WorkoutType
  phase     SeasonPhase
  label     String?
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, startDate, endDate])
  @@index([athleteId, sport])
}

/** Named calendar blocks on the season planner — not listed in race tables. */
model SeasonEvent {
  id        String   @id @default(cuid())
  athleteId String
  title     String
  notes     String?
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, startDate, endDate])
}

/** Tokenized, read-only ICS export for one athlete and one feed type. */
model CalendarFeed {
  id        String           @id @default(cuid())
  athleteId String
  type      CalendarFeedType
  tokenHash String           @unique
  /** Last 4 chars of token shown in UI after creation (no token storage). */
  tokenHint String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  /** Optional Google Calendar metadata for provider sync. */
  googleCalendarId String?
  googleSyncEnabled Boolean  @default(false)

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, type])
  @@index([athleteId])
}

/** Local item <-> external event mapping for provider sync. */
model CalendarEventMap {
  id        String           @id @default(cuid())
  athleteId String
  type      CalendarFeedType
  sourceId  String
  externalId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([type, sourceId])
  @@unique([athleteId, type, externalId])
  @@index([athleteId, type])
}

model WorkoutTemplateFolder {
  id        String      @id @default(cuid())
  coachId   String
  /** Sport this folder belongs to — folders are per-sport topic groups */
  sport     WorkoutType
  name      String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  coach     User              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  templates WorkoutTemplate[]

  @@index([coachId, sport])
  @@unique([coachId, sport, name])
}

model WorkoutTemplate {
  id          String       @id @default(cuid())
  coachId     String
  folderId    String?
  title       String
  type        WorkoutType
  sessionType SessionType  @default(CUSTOM)
  description String?
  durationMin Int?
  distanceKm  Float?
  /** Provenance for durationMin — drives per-athlete recompute on schedule. */
  durationSource PlannedMetricSource?
  /** Provenance for distanceKm. */
  distanceSource PlannedMetricSource?
  notes       String?
  structure   Json?
  swimEnvironment       SwimEnvironment?
  swimStructure         Json?
  plannedDistanceMeters Int?
  plannedDistanceMetersSource PlannedMetricSource?
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  coach    User                   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  folder   WorkoutTemplateFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  workouts Workout[]

  @@index([coachId])
  @@index([folderId])
}

model Workout {
  id              String        @id @default(cuid())
  athleteId       String
  templateId      String?
  date            DateTime      @db.Date
  type            WorkoutType
  sessionType     SessionType   @default(CUSTOM)
  title           String
  description     String?
  plannedDistance Float?
  plannedDuration Int?
  /** Provenance for plannedDistance (manual vs auto). */
  plannedDistanceSource PlannedMetricSource?
  /** Provenance for plannedDuration (manual vs auto). */
  plannedDurationSource PlannedMetricSource?
  coachNotes      String?
  /** When true, coachNotes are hidden from the athlete. */
  coachNotesPrivate Boolean @default(false)
  structure       Json?
  swimEnvironment       SwimEnvironment?
  swimStructure         Json?
  plannedDistanceMeters Int?
  plannedDistanceMetersSource PlannedMetricSource?
  tags            String[]      @default([])
  status          WorkoutStatus @default(PLANNED)
  sortOrder       Int           @default(0)
  selfLogged      Boolean       @default(false)
  isRescheduleGhost Boolean     @default(false)
  rescheduledFromId String?       @unique
  rescheduledFromDate DateTime?   @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  athlete         Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  template        WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  result          WorkoutResult?
  coachingThread  CoachingThread?
  rescheduledFrom Workout?         @relation("WorkoutReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledCopy Workout?         @relation("WorkoutReschedule")

  @@index([athleteId, date])
  @@index([date])
}

model WorkoutResult {
  id               String   @id @default(cuid())
  workoutId        String   @unique
  actualDistance   Float?
  /** Actual duration in minutes (fractional minutes preserve seconds from Strava). */
  actualDuration   Float?
  rpe              Int?
  /** Athlete 1–10 how the session felt (1 rough, 10 great). */
  feeling          Int?
  athleteNotes     String?
  /** When true, athleteNotes are hidden from the coach. */
  athleteNotesPrivate Boolean @default(false)
  coachReply       String?
  coachRepliedAt   DateTime?
  coachReplyReadAt DateTime?
  feedbackDismissedAt DateTime?
  stravaActivityId String?  @unique
  stravaActivityUrl String?
  /** Strava activity title (display context). */
  stravaActivityName String?
  /** Strava activity description — suggested coach comment; not shared until athlete opts in. */
  stravaActivityDescription String?
  /** Strava average heart rate (bpm). */
  averageHeartrate Float?
  /** Strava max heart rate (bpm). */
  maxHeartrate     Float?
  /** Strava average speed (m/s). */
  averageSpeedMps  Float?
  /** Strava max speed (m/s). */
  maxSpeedMps      Float?
  /** Strava total elevation gain (meters). */
  elevationGainM   Float?
  /** Strava relative effort / suffer score. */
  sufferScore      Int?
  /** Strava average cadence (spm / rpm depending on sport). */
  averageCadence   Float?
  /** Strava kilojoules (rides). */
  kilojoules       Float?
  /** Strava calories when available from detailed activity. */
  calories         Float?
  /** Strava average watts (rides). */
  averageWatts     Float?
  /** Encoded Google polyline from Strava map.summary_polyline (GPS route). */
  summaryPolyline  String?
  logType          AthleteLogType?
  completedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

/** Short Q&A thread between athlete and coach about a workout or race. */
model CoachingThread {
  id               String                @id @default(cuid())
  athleteId        String
  kind             CoachingThreadKind
  status           CoachingThreadStatus  @default(OPEN)
  workoutId        String?               @unique
  raceId           String?               @unique
  coachLastReadAt  DateTime?
  athleteLastReadAt DateTime?
  lastMessageAt    DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  athlete  Athlete            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  workout  Workout?           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  race     Race?              @relation(fields: [raceId], references: [id], onDelete: Cascade)
  messages CoachingMessage[]

  @@index([athleteId, lastMessageAt])
  @@index([athleteId, status, lastMessageAt])
  @@index([kind, lastMessageAt])
}

model CoachingMessage {
  id         String              @id @default(cuid())
  threadId   String
  authorRole CoachingAuthorRole
  kind       CoachingMessageKind @default(CHAT)
  body       String
  createdAt  DateTime            @default(now())

  thread CoachingThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model WebPushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DayNote {
  id                   String        @id @default(cuid())
  athleteId            String
  date                 DateTime      @db.Date
  status               DayNoteStatus @default(AVAILABLE)
  athleteNotes         String?
  athleteNotesPrivate  Boolean       @default(false)
  coachNotes           String?
  coachNotesPrivate    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, date])
  @@index([athleteId, date])
}
