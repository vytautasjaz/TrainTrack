generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  COACH
  ATHLETE
  ADMIN
}

enum CoachAthleteLinkStatus {
  PENDING
  ACCEPTED
  REJECTED
  REMOVED
}

enum WorkoutType {
  RUN
  BIKE
  SWIM
  STRENGTH
  HYROX
  TRIATHLON
  RECOVERY
  REST
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum AthleteLogType {
  COMPLETED
  SKIPPED
  ADJUSTED
  RESCHEDULED
}

enum SessionType {
  EASY_RUN
  RECOVERY_RUN
  LONG_RUN
  TEMPO
  THRESHOLD
  VO2_MAX
  INTERVALS
  FARTLEK
  RACE_PACE
  HILL_REPEATS
  BRICK
  STRENGTH
  CROSS_TRAINING
  HYROX
  CUSTOM
}

enum RaceType {
  MARATHON
  HALF_MARATHON
  FIVE_K
  TEN_K
  HYROX
  TRIATHLON
  CYCLING
  OTHER
}

/** Surface / course style — depends on sport (Road, Trail, Gravel, …). */
enum RaceCourseType {
  ROAD
  TRAIL
  TRACK
  GRAVEL
  MTB
  POOL
  OPEN_WATER
  OTHER
}

/** Triathlon distance variant when Race.type = TRIATHLON. */
enum TriathlonDistance {
  SPRINT
  OLYMPIC
  HALF
  FULL
  CUSTOM
}

enum RacePriority {
  A
  B
  C
}

enum RaceIntent {
  PLANNED
  WATCHING
}

enum RaceOutcome {
  FINISHED
  DID_NOT_START
  DNF
  DISMISSED
}

/** Triathlon (and similar) race segments — sport legs can link Strava; T1/T2 are time-only. */
enum RaceLegKind {
  SWIM
  T1
  BIKE
  T2
  RUN
}

enum SeasonPhase {
  BASE
  BUILD
  PEAK
  RACE
  RECOVERY
  TRANSITION
  MAINTENANCE
}

enum DayNoteStatus {
  NEEDS_COACH
  AVAILABLE
  SELF_PLANNED
  BUSY
}

enum AthleteStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SwimEnvironment {
  POOL
  OPEN_WATER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /** bcrypt hash — null when OAuth-only */
  passwordHash  String?
  /** Multi-role: ATHLETE, COACH, ADMIN (admin never self-assigned). */
  roles         UserRole[] @default([])
  /** Coach: warn on dashboard when an active athlete has no plan this many days ahead. */
  planningLeadDays Int @default(3)
  /** Coach: workout builder add-block presets (order, labels, seeds) per sport. */
  workoutBuilderPrefs Json?
  /** Skip onboarding until user picks Start Training / Become a Coach. */
  onboardingSkippedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  athleteProfile    Athlete?
  coachProfile      CoachProfile?
  templates         WorkoutTemplate[]
  stravaConnection  StravaConnection?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CoachProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  /** Public invite code, e.g. TT-83KF9 */
  coachingCode String   @unique
  bio          String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  links CoachAthleteLink[]
}

model CoachAthleteLink {
  id             String                  @id @default(cuid())
  coachProfileId String
  athleteId      String
  status         CoachAthleteLinkStatus  @default(PENDING)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  athlete      Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachProfileId, athleteId])
  @@index([athleteId, status])
  @@index([coachProfileId, status])
}

model StravaConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  stravaAthleteId String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  scope           String
  lastSyncedAt    DateTime?
  /** When true, app load / login may auto-sync (debounced). Manual sync always available. */
  autoSyncEnabled Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Athlete {
  id        String        @id @default(cuid())
  /** Legacy primary coach user id — prefer CoachAthleteLink for access. */
  coachId   String?
  userId    String?       @unique
  name      String
  status    AthleteStatus @default(ACTIVE)
  avatarUrl String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Training pace zones (min/km, e.g. 5.5 = 5:30/km)
  paceRecoveryMinPerKm    Float?
  paceEasyMinPerKm        Float?
  paceTempoMinPerKm       Float?
  paceThresholdMinPerKm   Float?
  paceVo2MaxMinPerKm      Float?

  // Bike speed zones (km/h)
  bikeSpeedRecoveryKph    Float?
  bikeSpeedEasyKph        Float?
  bikeSpeedTempoKph       Float?
  bikeSpeedThresholdKph   Float?
  bikeSpeedVo2MaxKph      Float?
  /** Functional Threshold Power (watts) for %FTP targets. */
  bikeFtpWatts            Int?

  // Critical swim speed (seconds per 100m, e.g. 95 = 1:35/100)
  swimCssSecPer100m       Float?

  // Heart rate zones (bpm)
  hrMax       Int?
  hrResting   Int?
  hrZone1Max  Int?
  hrZone2Max  Int?
  hrZone3Max  Int?
  hrZone4Max  Int?

  // Coach training planner: default sport rows always shown
  planSportRows WorkoutType[] @default([RUN, BIKE, SWIM])

  user             User?                     @relation(fields: [userId], references: [id])
  coachLinks       CoachAthleteLink[]
  races            Race[]
  seasonPhaseBlocks SeasonPhaseBlock[]
  seasonEvents      SeasonEvent[]
  workouts         Workout[]
  dayNotes         DayNote[]
  weekPlanSportRows        AthleteWeekPlanSportRow[]
  weekHiddenPlanSportRows AthleteWeekHiddenPlanSportRow[]

  @@index([coachId])
}

model AthleteWeekPlanSportRow {
  id        String      @id @default(cuid())
  athleteId String
  weekStart DateTime    @db.Date
  sport     WorkoutType
  createdAt DateTime    @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, weekStart, sport])
  @@index([athleteId, weekStart])
}

model AthleteWeekHiddenPlanSportRow {
  id        String      @id @default(cuid())
  athleteId String
  weekStart DateTime    @db.Date
  sport     WorkoutType
  createdAt DateTime    @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, weekStart, sport])
  @@index([athleteId, weekStart])
}

model Race {
  id        String       @id @default(cuid())
  athleteId String
  name      String
  date      DateTime     @db.Date
  location  String?
  type      RaceType
  sport     WorkoutType  @default(RUN)
  /** Road / Trail / Gravel / … — optional, sport-dependent. */
  courseType RaceCourseType?
  /** When type = TRIATHLON — Sprint, Olympic, 70.3, Ironman, Custom. */
  triathlonDistance TriathlonDistance?
  /** Freeform distance (km) when distance preset is Custom / Other. */
  customDistanceKm Float?
  priority  RacePriority @default(C)
  intent    RaceIntent   @default(PLANNED)
  goal      String?
  url       String?
  /** Athlete override; null uses default weeks for race type. */
  preparationWeeks Int?
  /** Set when athlete logs how the race went (or dismisses the prompt). */
  outcome      RaceOutcome?
  resultTime   String?
  resultNotes  String?
  resultLoggedAt DateTime?
  /** Cleared when athlete logs a result; set when coach dismisses the dashboard alert. */
  resultDismissedAt DateTime?
  /** Single-sport race: linked Strava activity (triathlon uses RaceLeg instead). */
  stravaActivityId   String? @unique
  stravaActivityUrl  String?
  stravaActivityName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  legs    RaceLeg[]

  @@index([athleteId, date])
  @@index([athleteId, intent, date])
  @@index([athleteId, outcome, date])
}

/** Per-leg plan + result for triathlon (swim / T1 / bike / T2 / run). */
model RaceLeg {
  id        String      @id @default(cuid())
  raceId    String
  kind      RaceLegKind
  sortOrder Int         @default(0)
  /** Target time for the plan (e.g. 1:05:00 or 3:30 for transitions). */
  plannedTime  String?
  plannedNotes String?
  /** Planned leg distance (km). Used for triathlon Custom splits. */
  plannedDistanceKm Float?
  /** Logged / Strava-derived split time. */
  resultTime String?
  stravaActivityId   String? @unique
  stravaActivityUrl  String?
  stravaActivityName String?
  actualDistanceKm   Float?
  actualDurationMin  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, kind])
  @@index([raceId])
}

/** Manual season planning phase block on a sport lane (not linked to workouts). */
model SeasonPhaseBlock {
  id        String       @id @default(cuid())
  athleteId String
  sport     WorkoutType
  phase     SeasonPhase
  label     String?
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, startDate, endDate])
  @@index([athleteId, sport])
}

/** Named calendar blocks on the season planner — not listed in race tables. */
model SeasonEvent {
  id        String   @id @default(cuid())
  athleteId String
  title     String
  notes     String?
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, startDate, endDate])
}

model WorkoutTemplate {
  id          String       @id @default(cuid())
  coachId     String
  title       String
  type        WorkoutType
  sessionType SessionType  @default(CUSTOM)
  description String?
  durationMin Int?
  distanceKm  Float?
  notes       String?
  structure   Json?
  swimEnvironment       SwimEnvironment?
  swimStructure         Json?
  plannedDistanceMeters Int?
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  coach    User      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  workouts Workout[]

  @@index([coachId])
}

model Workout {
  id              String        @id @default(cuid())
  athleteId       String
  templateId      String?
  date            DateTime      @db.Date
  type            WorkoutType
  sessionType     SessionType   @default(CUSTOM)
  title           String
  description     String?
  plannedDistance Float?
  plannedDuration Int?
  coachNotes      String?
  structure       Json?
  swimEnvironment       SwimEnvironment?
  swimStructure         Json?
  plannedDistanceMeters Int?
  tags            String[]      @default([])
  status          WorkoutStatus @default(PLANNED)
  sortOrder       Int           @default(0)
  selfLogged      Boolean       @default(false)
  isRescheduleGhost Boolean     @default(false)
  rescheduledFromId String?       @unique
  rescheduledFromDate DateTime?   @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  athlete         Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  template        WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  result          WorkoutResult?
  rescheduledFrom Workout?         @relation("WorkoutReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledCopy Workout?         @relation("WorkoutReschedule")

  @@index([athleteId, date])
  @@index([date])
}

model WorkoutResult {
  id               String   @id @default(cuid())
  workoutId        String   @unique
  actualDistance   Float?
  actualDuration   Int?
  rpe              Int?
  athleteNotes     String?
  coachReply       String?
  coachRepliedAt   DateTime?
  coachReplyReadAt DateTime?
  feedbackDismissedAt DateTime?
  stravaActivityId String?  @unique
  stravaActivityUrl String?
  /** Strava activity title (display context). */
  stravaActivityName String?
  /** Strava activity description — suggested coach comment; not shared until athlete opts in. */
  stravaActivityDescription String?
  logType          AthleteLogType?
  completedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

model DayNote {
  id        String         @id @default(cuid())
  athleteId String
  date      DateTime       @db.Date
  status    DayNoteStatus  @default(AVAILABLE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, date])
  @@index([athleteId, date])
}
