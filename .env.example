# Copy to .env for local testing, or run: npm run env:local
# See env/local.env and env/supabase.env.example for full templates.

DATABASE_URL="postgresql://traintrack:traintrack@localhost:5433/traintrack?schema=public"
DATABASE_URL_UNPOOLED="postgresql://traintrack:traintrack@localhost:5433/traintrack?schema=public"

# App URL (Auth.js + Strava OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Auth.js — also used as AUTH_URL when set; otherwise derived from NEXT_PUBLIC_APP_URL
AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required on Netlify/serverless so Server Action ids stay stable across deploys.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Strava API — https://www.strava.com/settings/api
# Authorization Callback Domain: localhost (or your production host)
# Login + link use Auth.js: {AUTH_URL}/api/auth/callback/strava
# Activity sync still uses: {NEXT_PUBLIC_APP_URL}/api/strava/callback
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_SCOPES="read,activity:read_all,profile:read_all"

# Web Push (Inbox notifications)
# Generate once and set both locally + Netlify:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URL used in push headers (mailto: or https)
VAPID_SUBJECT="mailto:you@example.com"
# Optional: allow POST /api/push/test in production
# ALLOW_PUSH_TEST=1
# NEXT_PUBLIC_APP_URL="https://your-app.example"
