# API for Home / workouts (phone can use LAN IP).
# Example: http://192.168.1.190:3000
EXPO_PUBLIC_API_URL=

# Google OAuth start URL — must NOT be a LAN IP (Google rejects IP redirect URIs).
# Use the same tunnel URL as the API when running: npm run mobile:tunnel
# Or your Netlify app after mobile Google routes are deployed:
# EXPO_PUBLIC_GOOGLE_OAUTH_URL=https://traintrack3000.netlify.app
EXPO_PUBLIC_GOOGLE_OAUTH_URL=
