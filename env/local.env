# Local development — Docker Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://traintrack:traintrack@localhost:5433/traintrack?schema=public"
DATABASE_URL_UNPOOLED="postgresql://traintrack:traintrack@localhost:5433/traintrack?schema=public"

# App URL (Auth.js + Strava OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-traintrack-local-secret"

# Google OAuth — redirect: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Strava API — https://www.strava.com/settings/api
# Auth.js login callback: http://localhost:3000/api/auth/callback/strava
# Sync callback (Authorization Callback Domain): localhost → /api/strava/callback
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_SCOPES="read,activity:read_all,profile:read_all"

# Optional: protect /api/cron/strava-sync (also set in Netlify for hourly sync)
CRON_SECRET=""

# Same uploaded coach/athlete photos as Netlify. Use with `npm run env:neon`.
# NEXT_PUBLIC_AVATAR_ORIGIN="https://lively-cascaron-ffd514.netlify.app"

# OpenAI — AI training plan drafts / adapts (server only)
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
